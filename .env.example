# Phase 2-3: Core Configuration
INCEPTION_API_KEY=your_key_here
SLACK_WEBHOOK_URL=
K8S_NAMESPACE=default
CHECK_INTERVAL=45000
ACTION_COOLDOWN_MS=120000

# Phase 4: Multi-Deployment Support
# Comma-separated list of deployments to monitor (single or multiple)
DEPLOYMENTS=app-deployment
# Alternative for multiple deployments:
# DEPLOYMENTS=app-deployment,db-service,cache-service

# Phase 3: Logging & Auditing
AUDIT_LOG_PATH=./audit/actions.jsonl
SLACK_SEND_ALL_DECISIONS=true
LOW_CONFIDENCE_THRESHOLD=0.6
LOW_CONFIDENCE_LOG_PATH=./audit/low-confidence.jsonl

# Phase 4: Dead Man's Switch (Liveness Check)
# Path to heartbeat file (should be on shared volume)
HEARTBEAT_PATH=/agent/heartbeat/timestamp.txt

# Phase 4: Prometheus Metrics (Kubernetes DNS FQDN)
# URL to Prometheus API for metrics queries
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090

# Phase 1-3: Agent Configuration (optional)
RUNBOOK_PATH=./agent/runbook.md
HEALTHY_CYCLE_THRESHOLD=3